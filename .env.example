# Copy to ignored .env.local. Never paste credentials in chat.
# Application and worker: runtime role mint_backend, verified TLS.
DATABASE_URL=
DATABASE_SSL_CA_FILE=.local/supabase-ca.crt
# Migration/seed tooling only: authorized owner/session connection.
DATABASE_MIGRATION_URL=
# Application public Auth configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Approved student domain is enforced in Auth hook and server: cb.students.amrita.edu.
# Public test key identifier must match RAZORPAY_KEY_ID. No live keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
# Setup, seed, and explicit integration-test tooling only. Never deploy to browser.
SUPABASE_ACCESS_TOKEN=
SUPABASE_SECRET_KEY=
# SMTP password lives in Supabase Auth settings. No Resend runtime SDK needed.
RESEND_API_KEY=

# Hosted scheduler authentication only; generated securely by deployment tooling.
WORKER_AUTH_SECRET=
# Optional hosted test origin for verification; local APP_URL stays local.
MINT_DEPLOYMENT_URL=
# Vercel only: Render HTTPS origin. Leave unset on Render and local development.
BACKEND_URL=
