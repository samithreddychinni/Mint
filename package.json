{
  "dependencies": {
    "@radix-ui/react-slot": "1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "name": "mint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "auth:setup": "tsx --env-file=.env.local scripts/auth-setup.ts",
    "worker": "tsx --env-file=.env.local src/jobs/worker.ts",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts",
    "test:browser": "playwright test",
    "notify": "tsx --env-file=.env.local scripts/notify.ts",
    "db:runtime-role": "tsx --env-file=.env.local scripts/runtime-role.ts",
    "format": "prettier --write src scripts tests"
  },
  "type": "module",
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "@zxing/library": "0.21.3"
  }
}
